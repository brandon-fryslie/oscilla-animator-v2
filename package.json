{
  "name": "oscilla-animator-v2",
  "version": "0.0.1",
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "description": "Oscilla Animator - Clean rewrite",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:audit": "node scripts/test-audit.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:memory": "VITEST_EXPOSE_GC=1 vitest run src/__tests__/memory-profile.test.ts",
    "test:webgpu-matrix": "node scripts/webgpu-browser-matrix.mjs",
    "test:rust-worker-gates": "pnpm run -s build:rust-renderer && playwright test tests/e2e/webgpu/rust-worker-gates.spec.ts",
    "test:three-grid-of-squares": "playwright test tests/e2e/webgpu/three-grid-of-squares.spec.ts",
    "test:payload-tester-visible": "node scripts/check-payload-tester-visible.mjs",
    "ci:webgpu-readiness": "node scripts/webgpu-ci-readiness-gate.mjs",
    "test:migration-readiness": "node scripts/webgpu-migration-readiness.mjs",
    "verify:renderer-shell": "node scripts/verify-renderer-shell-baseline.mjs",
    "bench": "vitest bench",
    "lint": "eslint src",
    "build:rust-renderer": "scripts/build-rust-renderer.sh",
    "test:native-webgpu-gates": "scripts/run-native-webgpu-gates.sh",
    "verify:rust-renderer-pkg": "node scripts/verify-rust-renderer-pkg.mjs",
    "ci:release-readiness": "pnpm -s typecheck && pnpm -s vitest run src/compiler/__tests__ src/services/__tests__/AsyncCompilerService.test.ts src/services/__tests__/CompileWorkerClient.test.ts src/services/__tests__/RuntimeService.test.ts src/runtime/__tests__/construct-one.test.ts",
    "build:debug-probe": "scripts/build-debug-probe.sh",
    "complexity:clean": "rm -rf reports/complexity .complexity-tmp",
    "complexity:eslint": "node scripts/complexity/eslint-complexity.mjs",
    "complexity:ts-morph": "node scripts/complexity/ts-morph-metrics.mjs",
    "complexity:depcruise": "node scripts/complexity/dependency-cruiser-report.mjs",
    "complexity:plato": "node scripts/complexity/plato-report.mjs",
    "complexity:typhon": "node scripts/complexity/typhon-report.mjs",
    "complexity:sonar": "node scripts/complexity/sonar-report.mjs",
    "complexity:compare": "node scripts/complexity/compare-reports.mjs",
    "complexity:all": "node scripts/complexity/run-all.mjs",
    "complexity:delta": "node scripts/complexity/commit-delta.mjs",
    "test:three-textured-tiles": "playwright test tests/e2e/webgpu/three-textured-tiles.spec.ts",
    "test:three-native-editor": "playwright test tests/e2e/webgpu/three-native-editor.spec.ts",
    "test:three-modifier-chain": "playwright test tests/e2e/webgpu/three-modifier-chain.spec.ts",
    "test:three-gradient": "playwright test tests/e2e/webgpu/three-gradient.spec.ts",
    "test:three-scatter": "playwright test tests/e2e/webgpu/three-scatter.spec.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mantine/core": "^8.3.13",
    "@mantine/hooks": "^8.3.13",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@mui/x-data-grid": "^8.24.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "acorn": "8.16.0",
    "bezier-js": "^6.1.4",
    "dockview": "^4.13.1",
    "earcut": "^3.0.2",
    "elkjs": "^0.11.0",
    "mermaid": "^11.4.1",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "motion": "^12.29.2",
    "nuqs": "^2.8.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "reactflow": "^11.11.4",
    "simplex-noise": "^4.0.3",
    "three": "0.185.0",
    "wgsl_reflect": "^1.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bezier-js": "^4.1.3",
    "@types/earcut": "^3.0.0",
    "@types/estree": "^1.0.8",
    "@types/node": "^25.0.10",
    "@types/three": "0.185.0",
    "@vitest/coverage-v8": "^2.1.9",
    "dependency-cruiser": "^17.3.8",
    "eslint": "^9.39.2",
    "eslint-plugin-sonarjs": "^4.0.0",
    "jsdom": "^27.4.0",
    "plato": "^1.7.0",
    "sonar-scanner": "^3.1.0",
    "ts-morph": "^27.0.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.54.0",
    "typhonjs-escomplex": "^0.1.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
