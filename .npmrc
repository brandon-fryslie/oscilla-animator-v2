# pnpm configuration

# Pre-approve prebuild scripts for esbuild (native module compilation)
# Allows versions 0.21.5 and 0.25.12 to run their build scripts without prompting
# This setting tells pnpm to allow build scripts for these packages
allow-build-scripts=esbuild@0.21.5,esbuild@0.25.12

# Alternatively, to allow all build scripts (less safe):
# allow-scripts=all
# unsafe-perm=true
